{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "aws_s3_bucket.results",
      "type": "aws_s3_bucket",
      "name": "results",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": "pqc-policy-fixture-not-deployed",
          "acl": "private"
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket_public_access_block.results",
      "type": "aws_s3_bucket_public_access_block",
      "name": "results",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": "pqc-policy-fixture-not-deployed",
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket_server_side_encryption_configuration.results",
      "type": "aws_s3_bucket_server_side_encryption_configuration",
      "name": "results",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": "pqc-policy-fixture-not-deployed",
          "rule": [
            {
              "apply_server_side_encryption_by_default": [
                {
                  "sse_algorithm": "aws:kms"
                }
              ]
            }
          ]
        },
        "after_unknown": {}
      }
    }
  ]
